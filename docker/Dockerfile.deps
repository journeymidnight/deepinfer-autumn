# deepinfer-deps: CANN 9.2 + Python 3.12 + GCC 13.
#
# Built and pushed from the Ascend host, NOT by CP -- same split as
# build-lerobot-deps in this account. ppa.launchpadcontent.net serves the CN
# build pool at ~70 kB/s with intermittent 503s (one CP run lost nine packages
# that way and failed after 18 minutes), while this identical sequence installs
# cleanly from the host. USTC's launchpad proxy is not a substitute: it answers
# 200 on Release and 503 on the pool, so it fails later while looking healthy.
#
# HONEST PROVENANCE: the image currently in the registry was produced by
# `docker commit` of a container on that host, running exactly these steps via
# scripts/toolchain.sh, because `docker build` on that host died twice with its
# exit code lost. This file is the reproducible form of the same recipe.
#
#   docker build -f docker/Dockerfile.deps -t <registry>/deepinfer-deps:cann9.2-py312-gcc13 .
ARG BASE_IMAGE=quay.nju.edu.cn/ascend/cann:9.2.0-beta.1-950-ubuntu22.04-py3.11-devel
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Optional Ubuntu mirror for the apt steps, as the autumn-rs pipeline passes:
#   --build-arg APT_MIRROR=https://mirrors.ivolces.com
# The PPAs stay on launchpad and are unaffected.
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
      m="${APT_MIRROR%/}"; \
      sed -i -E "s#https?://[a-z.]*archive\.ubuntu\.com#${m}#g; s#https?://security\.ubuntu\.com#${m}#g" \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null || true; \
      echo "apt via ${m}"; \
    fi

# Split from the PPA install below so a retry reuses this layer from cache.
RUN apt-get update \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=10 \
        software-properties-common ca-certificates gnupg dirmngr \
        curl git pkg-config make cmake ninja-build \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update

# A partial failure leaves dpkg half-configured, and the next plain retry dies
# on "Unmet dependencies. Try apt --fix-broken install" rather than on the
# original 503 -- which is how a six-pass loop burned five useless passes. Each
# pass therefore repairs the package database before retrying.
#
# ppa.launchpadcontent.net answers 503 intermittently from the CN build pool
# and serves at ~70 kB/s: a first attempt fetched 65 MB in 15m31s and still
# lost 9 packages to 503s. The retries are for that, not for a dependency
# problem -- the identical sequence installs cleanly on the target host. Each
# pass re-runs `apt-get update` because a 503 can also poison the package
# lists, and apt keeps whatever .debs it already fetched, so passes get cheaper.
RUN set -eu; \
    ok=0; \
    for i in 1 2 3 4 5 6; do \
        if apt-get install -y --no-install-recommends \
                -o Acquire::Retries=10 -o Acquire::http::Timeout=60 --fix-missing \
                python3.12 python3.12-dev python3.12-venv gcc-13 g++-13; then ok=1; break; fi; \
        echo "=== apt attempt $i failed (launchpad 503s expected); retrying ==="; \
        sleep 20; \
        dpkg --configure -a || true; \
        apt-get --fix-broken install -y || true; \
        apt-get update || true; \
    done; \
    [ "$ok" = 1 ] || { echo "apt never completed after 6 attempts"; exit 100; }; \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-13; \
    rm -rf /var/lib/apt/lists/*; \
    gcc --version | head -1; python3.12 -V

# DeepInfer runs from this venv, so a bad install cannot brick the CANN
# toolkit's own interpreter (/usr/local/python3.11.16).
ENV VIRTUAL_ENV=/opt/di-venv
RUN python3.12 -m venv "$VIRTUAL_ENV" && "$VIRTUAL_ENV/bin/pip" install -U pip wheel setuptools
ENV PATH=$VIRTUAL_ENV/bin:$PATH
ENV DEEPINFER_ACCELERATOR=ascend

# The heavy python dependencies belong HERE, not in the pipeline that runs on
# every change: torch 2.13.0+cpu is ~900 MB, and torch_npu, einops and the rest
# follow it. build.sh re-runs this same pip install, which is then satisfied and
# returns in seconds.
#
# Only the requirements files are fetched, at the same revision DEEPINFER_REV
# pins, so the deps image and the build cannot disagree about what is installed.
# NOTE: rebuild this image when DEEPINFER_REV or any requirements file changes.
#
# The pipeline passes --build-arg PIP_INDEX_URL=https://mirrors.ivolces.com/pypi/simple,
# which overrides the default below, so the value is corrected in the step
# itself rather than trusted: that index stops at einops 0.8.1 while
# requirements.txt pins 0.8.2 -- checked against pypi, which lists 0.8.2 as the
# latest release, so this is the mirror lagging and not a bad pin.
#
# The replacement is huaweicloud's mirror rather than pypi.org because the base
# image already configures it in /root/.pip/pip.conf: it is in-region for the
# build pool, and it does carry 0.8.2 (verified). Note that simply UNSETTING
# PIP_INDEX_URL would also land there, silently -- the explicit value is so the
# index is visible in the build log. Same guard as docker/Dockerfile.
ARG PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
ARG GITHUB_MIRROR=https://ghfast.top/https://github.com/
COPY DEEPINFER_REV /opt/DEEPINFER_REV
RUN set -eux; \
    sha="$(cut -d= -f2 /opt/DEEPINFER_REV)"; \
    base="${GITHUB_MIRROR:-https://github.com/}"; \
    mkdir -p /opt/req && cd /opt/req && git init -q; \
    git remote add origin "${base}deepseek-ai/DeepInfer.git"; \
    git fetch --depth 1 origin "$sha"; \
    git checkout -q FETCH_HEAD -- requirements.txt requirements-ascend.txt requirements-dev.txt; \
    ls -l; \
    idx="$PIP_INDEX_URL"; \
    case "$idx" in *mirrors.ivolces.com*) \
        echo "PIP_INDEX_URL=$idx lacks einops 0.8.2 (its index stops at 0.8.1); using the huaweicloud mirror"; \
        idx=https://repo.huaweicloud.com/repository/pypi/simple ;; \
    esac; \
    PIP_INDEX_URL="$idx" pip install -r requirements-ascend.txt; \
    python -c "import torch; print('torch', torch.__version__)"; \
    pip list 2>/dev/null | grep -iE "^(torch|torch-npu|einops) " || true

CMD ["bash"]
